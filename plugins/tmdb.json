{
  "версія": 1,
  "плагін": {
    "ключ": "ref-tmdb",
    "назва": "Рейтинг серіалів і фільмів (TMDB)",
    "опис": "Додає до карток серіалів і фільмів оцінку, оригінальну назву, рік і обкладинку. Ключ не потрібен — читається публічна сторінка themoviedb.org.",
    "версія": "2.1",
    "оновлено": "2026-09-05"
  },
  "довідник": {
    "назва": "TMDB",
    "домени": [
      "www.themoviedb.org",
      "themoviedb.org",
      "media.themoviedb.org"
    ],
    "для": [
      "series",
      "movie"
    ],
    "ключ-потрібен": false,
    "пошук": {
      "адреса": "https://www.themoviedb.org/search/tv?query={q}&language=uk-UA",
      "як": "html",
      "картка": "[data-object-id]",
      "база": "https://www.themoviedb.org",
      "поля": {
        "адреса": {
          "вузол": "a[href*='/tv/'], a[href*='/movie/']",
          "атрибут": "href"
        },
        "назва": {
          "вузол": "h2 span",
          "чистка": "назва"
        },
        "оригінал": {
          "вузол": "h2 span.font-light",
          "витяг": "\\(([^)]{2,80})\\)"
        },
        "постер": {
          "вузол": "img.poster",
          "атрибут": [
            "src",
            "data-src"
          ]
        },
        "рік": {
          "вузол": ".release_date",
          "витяг": "((?:19|20)\\d{2})",
          "число": true
        }
      }
    },
    "сторінка": {
      "поля": {
        "рейтинг": [
          {
            "json-ld": "aggregateRating.ratingValue"
          }
        ],
        "постер": [
          {
            "мета": "image"
          }
        ],
        "оригінал": [
          {
            "підпис": [
              "оригінальна назва",
              "оригинальное название",
              "original name",
              "original title"
            ],
            "обрізати": 120
          }
        ],
        "стан": [
          {
            "підпис": [
              "статус",
              "status"
            ],
            "обрізати": 40
          }
        ],
        "тривалість": [
          {
            "json-ld": "duration",
            "чистка": "тривалість"
          },
          {
            "вузол": ".runtime",
            "чистка": "тривалість"
          }
        ],
        "країна": [
          {
            "json-ld": "countryOfOrigin",
            "чистка": "країна"
          }
        ],
        "жанр": [
          {
            "json-ld": "genre"
          }
        ],
        "всього": [
          {
            "json-ld": "numberOfEpisodes"
          }
        ]
      }
    },
    "версія": "2.1"
  }
}
