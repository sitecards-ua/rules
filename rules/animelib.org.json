{
  "версія": 1,
  "сайт": {
    "ключ": "animelib",
    "назва": "AnimeLib",
    "домени": [
      "animelib.org",
      "anilib.me"
    ],
    "перевірено": "2026-08-21",
    "читає": [
      "title",
      "origTitle",
      "poster",
      "ep",
      "latest",
      "season",
      "team",
      "year"
    ],
    "впізнавати": [
      "^(?:www\\.)?(?:anime|manga|ranobe|slash)lib\\.[a-z.]+$",
      "^(?:www\\.)?anilib\\.[a-z.]+$"
    ]
  },
  "сторінка": {
    "обрізати-адресу": "(?:/watch)?(?:\\?.*)?(?:#.*)?$",
    "ключ-картки": {
      "спосіб": "dle-id",
      "вираз": "/anime/(\\d{1,7})"
    }
  },
  "поля": {
    "назва": [
      {
        "json-ld": "name",
        "чистка": "назва"
      },
      {
        "вузол": "h1",
        "чистка": "назва"
      }
    ],
    "оригінал": [
      {
        "json-ld": "alternativeHeadline",
        "витяг": "([A-Za-z][A-Za-z0-9 :'!.\\-]{2,60})"
      },
      {
        "підпис": [
          "альтернативные названия"
        ],
        "витяг": "([A-Za-z][A-Za-z0-9 :'!.\\-]{2,60})"
      }
    ],
    "постер": [
      {
        "json-ld": "image"
      },
      {
        "мета": "image"
      }
    ],
    "рік": [
      {
        "підпис": [
          "выпуск",
          "випуск"
        ],
        "витяг": "((?:19|20)\\d{2})",
        "число": true
      },
      {
        "json-ld": "copyrightYear",
        "витяг": "((?:19|20)\\d{2})",
        "число": true
      }
    ],
    "жанр": [
      {
        "json-ld": "genre"
      }
    ],
    "тип": [
      {
        "адреса": "/anime/",
        "збіг": {
          ".": "anime"
        }
      }
    ],
    "тривалість": [
      {
        "підпис": [
          "эпизоды",
          "епізоди"
        ],
        "витяг": "\\[(\\d{1,4})\\s*мин",
        "число": true
      }
    ],
    "доступно": [
      {
        "підпис": [
          "эпизоды",
          "епізоди"
        ],
        "витяг": "(\\d{1,4})\\s*из",
        "число": true
      }
    ],
    "всього": [
      {
        "підпис": [
          "эпизоды",
          "епізоди"
        ],
        "витяг": "из\\s+(\\d{1,4})",
        "число": true
      }
    ],
    "серія": [
      {
        "драбина": {
          "із-заголовка": true
        },
        "вимагає-видимості": true
      }
    ]
  },
  "шаблон": {
    "вид-читання": "меню",
    "меню": ".menu-list",
    "пункт-меню": ".menu-item",
    "активний-пункт": ".menu-item.is-active",
    "текст-пункту": ".menu-item__text",
    "вкладка-режиму": ".tabs-item.is-active",
    "мітка-серій": "^эпизоды|^епізоди|^episodes$",
    "мітка-року": "^выпуск|^вихід|^release",
    "сезон-у-слагу": "-([2-9])-(?:anime|manga)\\b",
    "вид-за-адресою": {
      "/manga/": "manga"
    },
    "вид": "anime",
    "обкладинка": "img.cover__img, .cover img",
    "пошук": {
      "як": "json",
      "адреса": "https://api.cdnlibs.org/api/anime?site_id[]=5&q={q}",
      "список": "data",
      "вид": "аніме",
      "сторінка": "/ru/anime/{slug}",
      "постер-довідника": "https://shikimori.one/system/animes/preview/{id}.jpg",
      "сторінка-довідника": "https://shikimori.one/animes/{id}",
      "поля": {
        "слаг": "slug_url",
        "назва": [
          "rus_name",
          "name",
          "eng_name"
        ],
        "оригінал": [
          "name",
          "eng_name"
        ],
        "довідник": "shikimori_href",
        "обкладинка": "cover",
        "дата": "releaseDateString",
        "оцінка": "rating",
        "тип": "type",
        "стан": "status"
      }
    }
  }
}
