{
  "версія": 1,
  "сайт": {
    "ключ": "animelib",
    "назва": "AnimeLib",
    "домени": ["animelib.org"],
    "перевірено": "2026-09-04"
  },
  "сторінка": {
    "тільки-у-вкладці": true,
    "заголовок-про-відкрите": false,
    "обрізати-адресу": "(?:/watch)?(?:\\?.*)?(?:#.*)?$",
    "ключ-картки": { "спосіб": "dle-id", "вираз": "/anime/(\\d{1,7})" }
  },
  "поля": {
    "назва": [
      { "json-ld": "name", "чистка": "назва" },
      { "вузол": "h1", "чистка": "назва" }
    ],
    "оригінал": [
      { "json-ld": "alternativeHeadline", "витяг": "([A-Za-z][A-Za-z0-9 :'!.\\-]{2,60})" },
      { "підпис": ["альтернативные названия"], "витяг": "([A-Za-z][A-Za-z0-9 :'!.\\-]{2,60})" }
    ],
    "постер": [
      { "json-ld": "image" },
      { "мета": "image" }
    ],
    "рік": [
      { "підпис": ["выпуск", "випуск"], "витяг": "((?:19|20)\\d{2})", "число": true },
      { "json-ld": "copyrightYear", "витяг": "((?:19|20)\\d{2})", "число": true }
    ],
    "жанр": [
      { "json-ld": "genre" }
    ],
    "тип": [
      { "адреса": "/anime/", "збіг": { ".": "anime" } }
    ],
    "тривалість": [
      { "підпис": ["эпизоды", "епізоди"], "витяг": "\\[(\\d{1,4})\\s*мин", "число": true }
    ],
    "доступно": [
      { "підпис": ["эпизоды", "епізоди"], "витяг": "(\\d{1,4})\\s*из", "число": true }
    ],
    "всього": [
      { "підпис": ["эпизоды", "епізоди"], "витяг": "из\\s+(\\d{1,4})", "число": true }
    ],
    "серія": [
      { "драбина": { "із-заголовка": false } }
    ]
  }
}
