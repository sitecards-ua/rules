{
  "версія": 1,
  "сайт": {
    "ключ": "anitube",
    "назва": "AniTube",
    "домени": ["anitube.in.ua"],
    "перевірено": "2026-08-31"
  },
  "сторінка": {
    "тільки-у-вкладці": false,
    "заголовок-про-відкрите": false,
    "обрізати-адресу": "/(watch|player|episode)\\b.*$",
    "ключ-картки": { "спосіб": "шлях", "прибрати-розширення": true }
  },
  "поля": {
    "назва": [
      { "вузол": "h1", "чистка": "назва" },
      { "вузол": ".full-title", "чистка": "назва" },
      { "мета": "title", "чистка": "назва" }
    ],
    "оригінал": [
      { "підпис": ["оригінальна назва", "оригинальное название", "оригінальна назва аніме"], "обрізати": 160 },
      { "поділитись": true, "чистка": "латиниця-після-скісної" },
      { "мета": "title", "чистка": "латиниця-після-скісної" },
      { "запит": "оригінал" }
    ],
    "постер": [
      { "мета": "image" },
      { "постер": true }
    ],
    "рік": [
      { "підпис": ["рік виходу аніме", "рік виходу", "год выхода"], "витяг": "((?:19|20)\\d{2})", "число": true }
    ],
    "тип": [
      { "адреса": "/(?:film|movie|filmy|films)/", "збіг": { ".": "movie" } },
      "anime"
    ],
    "озвучки": { "плеєр": "dle" },
    "серія": {
      "драбина": {
        "позначена": [".playlists-videos li.active"],
        "із-заголовка": false
      },
      "вимагає-видимості": true
    },
    "доступно": { "вийшло": { "підпис": ["серій", "серии", "кількість серій", "епізоди"] } },
    "всього": { "вийшло": { "підпис": ["серій", "серии", "кількість серій", "епізоди"] } },
    "сезон": [
      { "текст": "(\\d{1,2})\\s*сезон", "число": true },
      { "адреса": "sezon-(\\d{1,2})", "число": true }
    ]
  },
  "запити": [
    {
      "ім'я": "оригінал",
      "поле": "оригінал",
      "коли": "порожнє:оригінал",
      "id-з-адреси": "/(\\d{1,7})-[^/]*\\.html",
      "адреса": "{origin}/engine/ajax/get_orgname.php?id={id}",
      "як": "json",
      "взяти": "nameorg"
    }
  ],
  "пошук": {
    "адреса": "https://{host}/index.php?do=search&subaction=search&titleonly=3&full_search=1&result_from=1&story={q}",
    "як": "html",
    "картка": "#dle-content article.story, article.story",
    "поля": {
      "адреса": { "вузол": "h2 a", "атрибут": "href" },
      "назва": { "вузол": "h2 a", "чистка": "назва" },
      "постер": { "вузол": ".story_post img", "атрибут": ["data-src", "src"] },
      "рік": { "вузол": ".story_c_inf", "витяг": "Рік виходу[^\\d]*(\\d{4})", "число": true },
      "рейтинг": { "вузол": ".story_c_inf", "витяг": "(\\d[.,]\\d)\\s*/\\s*10", "чистка": "кома-в-крапку", "число": true }
    }
  }
}
