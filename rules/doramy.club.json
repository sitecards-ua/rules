{
  "версія": 1,
  "сайт": {
    "ключ": "doramyclub",
    "назва": "Дорамы Club",
    "домени": [
      "doramy.club"
    ],
    "перевірено": "2026-09-09",
    "читає": [
      "title",
      "poster",
      "total",
      "team",
      "year"
    ],
    "впізнавати": [
      "^(?:www\\.)?doramy\\.club$"
    ],
    "перевпізнати-назви": true
  },
  "сторінка": {
    "ключ-картки": {
      "спосіб": "шлях",
      "прибрати-розширення": false
    }
  },
  "поля": {},
  "шаблон": {
    "вид-читання": "табличка",
    "рядок-серій": "^серіал:?$|^сериал:?$|^кількість серій:?$|^количество серий:?$",
    "рядок-озвучки": "^озвучка:?$|^озвучення:?$",
    "теги": ".table-tag td, table.table-tag td",
    "ознака-сторінки": ".table-sin, .table-tag, td.s1",
    "заголовок": [
      "h1[itemprop=\"name\"]",
      "h1",
      ".post-singl h1"
    ],
    "постер": [
      "img.s-poster",
      ".img-poster img"
    ]
  }
}
