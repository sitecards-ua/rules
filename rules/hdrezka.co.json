{
  "версія": 1,
  "сайт": {
    "ключ": "hdrezka",
    "назва": "HDrezka",
    "домени": ["hdrezka.co"],
    "перевірено": "2026-09-04"
  },
  "сторінка": {
    "тільки-у-вкладці": true,
    "заголовок-про-відкрите": false,
    "обрізати-адресу": "#.*$",
    "ключ-картки": { "спосіб": "dle-id", "вираз": "/(\\d{1,7})-[^/]*\\.html" }
  },
  "поля": {
    "назва": [
      { "вузол": "h1", "чистка": "назва" },
      { "мета": "title", "чистка": "назва" }
    ],
    "оригінал": [
      { "вузол": ".b-post__origtitle" }
    ],
    "постер": [
      { "вузол": ".b-sidecover img", "атрибут": "src" },
      { "мета": "image" }
    ],
    "рік": [
      { "підпис": ["дата выхода", "дата виходу", "год"], "витяг": "((?:19|20)\\d{2})", "число": true },
      { "мета": "title", "витяг": "\\((\\d{4})\\)", "число": true }
    ],
    "тип": [
      { "адреса": "/(films?|movie)/", "збіг": { ".": "movie" } },
      { "адреса": "/(series|cartoons|animation|show)/", "збіг": { ".": "series" } }
    ],
    "сезон": [
      { "вузол": "#simple-seasons-tabs .active", "витяг": "(\\d{1,2})", "число": true }
    ],
    "доступно": [
      { "усі": "[id^=\"simple-episodes-list\"]:not([style]) li", "витяг": "(\\d{1,4})", "взяти": "найбільше", "число": true }
    ],
    "озвучки": [
      { "усі": "#translators-list li", "взяти": "список" }
    ],
    "серія": [
      { "драбина": { "позначена": ["[id^=\"simple-episodes-list\"]:not([style]) li.active"], "із-заголовка": false } }
    ]
  }
}
