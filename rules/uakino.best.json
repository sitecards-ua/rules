{
  "версія": 1,
  "сайт": {
    "ключ": "uakino",
    "назва": "UAKino",
    "домени": ["uakino.best", "uakino.com.ua"],
    "перевірено": "2026-08-31"
  },
  "сторінка": {
    "тільки-у-вкладці": false,
    "заголовок-про-відкрите": false,
    "обрізати-адресу": "/(watch|player|episode)\\b.*$",
    "ключ-картки": { "спосіб": "dle-id", "вираз": "/(\\d{1,7})-[^/]*\\.html" }
  },
  "поля": {
    "назва": [
      { "вузол": "h1.ua-full-title", "чистка": "назва" },
      { "вузол": "h1", "чистка": "назва" },
      { "вузол": ".solototle", "чистка": "назва" },
      { "мета": "title", "чистка": "назва" }
    ],
    "постер": [
      { "мета": "image" },
      { "постер": true }
    ],
    "рік": [
      { "підпис": ["рік виходу", "рік", "год выхода"], "витяг": "((?:19|20)\\d{2})", "число": true }
    ],
    "тип": [
      { "адреса": "/(?:filmy|films?|movie)/", "збіг": { ".": "movie" } },
      { "будь-що-з": [
          { "підпис": ["жанр", "жанри"], "витяг": "(ан[іи]ме)" },
          { "адреса": "(animeukr|anime)" }
        ], "тоді": "anime" },
      "series"
    ],
    "озвучки": { "плеєр": "dle" },
    "серія": {
      "драбина": {
        "позначена": [".playlists-videos li.active"],
        "із-заголовка": false
      },
      "вимагає-видимості": true
    },
    "доступно": {
      "вийшло": { "підпис": ["кількість серій", "кількість епізодів", "серій", "епізоди"] }
    },
    "всього": {
      "вийшло": { "підпис": ["кількість серій", "кількість епізодів", "серій", "епізоди"] }
    },
    "сезон": [
      { "текст": "(\\d{1,2})\\s*сезон", "не якщо": "\\d{1,2}\\s*[-–]\\s*\\d{1,2}\\s*сезон", "число": true },
      { "адреса": "sezon-(\\d{1,2})", "число": true }
    ]
  },
  "запити": [
    {
      "ім'я": "плеєр",
      "поле": "озвучки",
      "коли": "порожнє:озвучки",
      "id-з-адреси": "/(\\d{1,7})-[^/]*\\.html",
      "адреса": "{origin}/engine/ajax/playlists.php?news_id={id}&xfield=playlist",
      "як": "json",
      "взяти": "плеєр"
    }
  ],
  "пошук": {
    "адреса": "https://{host}/index.php?do=search&subaction=search&titleonly=3&full_search=1&result_from=1&story={q}",
    "як": "html",
    "картка": "#dle-content .movie-item, .movie-item.short-item",
    "поля": {
      "адреса": { "вузол": "a.movie-title", "атрибут": "href", "не якщо": "/news/" },
      "назва": { "вузол": "a.movie-title", "чистка": "назва" },
      "постер": { "вузол": ".movie-img img", "атрибут": ["data-src", "src"] },
      "рік": { "вузол": ".movie-desk-item", "витяг": "((?:19|20)\\d{2})", "число": true },
      "доступно": { "вузол": ".full-season", "витяг": "\\d{1,4}\\s*[-–]\\s*(\\d{1,4})\\s*сер", "число": true }
    }
  }
}
