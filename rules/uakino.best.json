{
  "версія": 1,
  "сайт": {
    "ключ": "uakino",
    "назва": "UAKino",
    "домени": [
      "uakino.best",
      "uakino.com.ua"
    ],
    "перевірено": "2026-08-24",
    "читає": [
      "title",
      "poster",
      "ep",
      "latest",
      "season",
      "team",
      "year"
    ],
    "впізнавати": [
      "^(?:www\\.)?uakino\\.[a-z.]+$"
    ]
  },
  "сторінка": {
    "обрізати-адресу": "/(watch|player|episode)\\b.*$",
    "ключ-картки": {
      "спосіб": "dle-id",
      "вираз": "/(\\d{1,7})-[^/]*\\.html"
    }
  },
  "поля": {
    "назва": [
      {
        "вузол": "h1.ua-full-title",
        "чистка": "назва"
      },
      {
        "вузол": "h1",
        "чистка": "назва"
      },
      {
        "вузол": ".solototle",
        "чистка": "назва"
      },
      {
        "мета": "title",
        "чистка": "назва"
      }
    ],
    "постер": [
      {
        "мета": "image"
      },
      {
        "постер": true
      }
    ],
    "рік": [
      {
        "підпис": [
          "рік виходу",
          "рік",
          "год выхода"
        ],
        "витяг": "((?:19|20)\\d{2})",
        "число": true
      }
    ],
    "тип": [
      {
        "адреса": "/(?:filmy|films?|movie)/",
        "збіг": {
          ".": "movie"
        }
      },
      {
        "будь-що-з": [
          {
            "підпис": [
              "жанр",
              "жанри"
            ],
            "витяг": "(ан[іи]ме)"
          },
          {
            "адреса": "(animeukr|anime)"
          }
        ],
        "тоді": "anime"
      },
      "series"
    ],
    "озвучки": {
      "плеєр": "dle"
    },
    "серія": {
      "драбина": {
        "позначена": [
          ".playlists-videos li.active"
        ],
        "із-заголовка": false
      },
      "вимагає-видимості": true
    },
    "доступно": {
      "вийшло": {
        "підпис": [
          "кількість серій",
          "кількість епізодів",
          "серій",
          "епізоди"
        ]
      }
    },
    "всього": {
      "вийшло": {
        "підпис": [
          "кількість серій",
          "кількість епізодів",
          "серій",
          "епізоди"
        ]
      }
    },
    "сезон": [
      {
        "вузол": "h1",
        "витяг": "(\\d{1,2})\\s*сезон",
        "не якщо": "\\d{1,2}\\s*[-–]\\s*\\d{1,2}\\s*сезон",
        "число": true
      },
      {
        "адреса": "sezon-(\\d{1,2})",
        "число": true
      },
      {
        "адреса": "(\\d{1,2})-sezon",
        "не якщо": "\\d{1,2}-\\d{1,2}-sezon",
        "число": true
      }
    ]
  },
  "запити": [
    {
      "ім'я": "плеєр",
      "поле": "озвучки",
      "коли": "порожнє:озвучки",
      "id-з-адреси": "/(\\d{1,7})-[^/]*\\.html",
      "адреса": "{origin}/engine/ajax/playlists.php?news_id={id}&xfield=playlist",
      "як": "json",
      "взяти": "плеєр"
    }
  ],
  "пошук": {
    "адреса": "https://{host}/index.php?do=search&subaction=search&titleonly=3&full_search=1&result_from=1&story={q}",
    "як": "html",
    "картка": "#dle-content .movie-item, .movie-item.short-item",
    "поля": {
      "адреса": {
        "вузол": "a.movie-title",
        "атрибут": "href",
        "не якщо": "/news/"
      },
      "назва": {
        "вузол": "a.movie-title",
        "чистка": "назва"
      },
      "постер": {
        "вузол": ".movie-img img",
        "атрибут": [
          "data-src",
          "src"
        ]
      },
      "рік": {
        "вузол": ".movie-desk-item",
        "витяг": "((?:19|20)\\d{2})",
        "число": true
      },
      "доступно": {
        "вузол": ".full-season",
        "витяг": "\\d{1,4}\\s*[-–]\\s*(\\d{1,4})\\s*сер",
        "число": true
      }
    }
  },
  "шаблон": {
    "вид-читання": "підписи",
    "озвучка": "плеєр",
    "аніме-за-жанром": true,
    "підписи": {
      "рік": [
        "рік виходу",
        "рік",
        "рік виходу аніме",
        "год выхода"
      ],
      "серії": [
        "кількість серій",
        "кількість епізодів",
        "серій",
        "епізоди"
      ],
      "переклад": [
        "переклад",
        "озвучення",
        "озвучка",
        "перевод"
      ],
      "жанр": [
        "жанр",
        "категорія"
      ]
    },
    "фільм-адреса": "/(?:film|movie|filmy|films)/",
    "заголовок": [
      "h1.ua-full-title",
      "h1",
      ".solototle",
      ".full-title",
      ".fullstory-title"
    ],
    "запит": {
      "що": "плеєр",
      "адреса": "/engine/ajax/playlists.php?news_id={id}&xfield=playlist"
    },
    "пошук": {
      "адреса": "https://{host}/index.php?do=search&subaction=search&titleonly=3&full_search=1&result_from=1&story={q}",
      "картка": "#dle-content .movie-item, .movie-item.short-item",
      "посилання": "a.movie-title[href], .movie-img a[href]",
      "лише-з-адресою": true,
      "не-адреса": "/news/",
      "назва": "a.movie-title",
      "обкладинка": ".movie-img",
      "сезон-серії": ".full-season",
      "якість": ".full-quality",
      "рядки-опису": ".movie-desk-item",
      "рік-в-описі": "Рік виходу:?\\s*(\\d{4})",
      "оцінка-в-описі": "IMDB:?\\s*(\\d(?:[.,]\\d)?)",
      "вид-за-адресою": {
        "/filmy/": "фільм",
        "/cartoon/cartoonseries/": "мультсеріал",
        "/cartoon/": "мультфільм",
        "/animeukr/": "аніме",
        "/seriesss/": "серіал"
      }
    }
  }
}
