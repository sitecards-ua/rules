{
  "версія": 1,
  "сайт": {
    "ключ": "uaserials",
    "назва": "UASerials",
    "домени": [
      "uaserials.com",
      "uaserials.my",
      "uaserials.one",
      "uaserials.vip",
      "uaserial.tv"
    ],
    "перевірено": "2026-09-03"
  },
  "сторінка": {
    "тільки-у-вкладці": false,
    "заголовок-про-відкрите": false,
    "обрізати-адресу": "/(watch|player|episode)\\b.*$",
    "ключ-картки": {
      "спосіб": "шлях",
      "прибрати-розширення": true
    }
  },
  "поля": {
    "назва": [
      {
        "вузол": "h1.short-title",
        "чистка": "назва"
      },
      {
        "вузол": ".short-title",
        "чистка": "назва"
      },
      {
        "вузол": "h1",
        "чистка": "назва"
      },
      {
        "вузол": ".fullstory-title",
        "чистка": "назва"
      },
      {
        "мета": "title",
        "витяг": "[«\"]([^«»\"]{2,80})[»\"]",
        "чистка": "назва"
      },
      {
        "мета": "title",
        "чистка": "назва"
      }
    ],
    "постер": [
      {
        "мета": "image"
      },
      {
        "постер": true
      }
    ],
    "рік": [
      {
        "підпис": [
          "рік виходу",
          "рік",
          "год выхода"
        ],
        "витяг": "((?:19|20)\\d{2})",
        "число": true
      }
    ],
    "тип": [
      {
        "адреса": "/(?:film|movie|movies|filmy)/",
        "збіг": {
          ".": "movie"
        }
      },
      "series"
    ],
    "озвучка": [
      {
        "підпис": [
          "переклад",
          "озвучення",
          "озвучка",
          "перевод"
        ],
        "обрізати": 120
      }
    ],
    "серія": {
      "драбина": {
        "позначена": [
          ".playlists-videos li.active",
          ".pmovie__player li.active"
        ],
        "із-заголовка": false
      },
      "вимагає-видимості": true
    },
    "доступно": {
      "вийшло": {
        "підпис": [
          "прогрес",
          "прогресс",
          "кількість серій",
          "серій"
        ]
      }
    },
    "всього": {
      "вийшло": {
        "підпис": [
          "прогрес",
          "прогресс",
          "кількість серій",
          "серій"
        ]
      }
    },
    "сезон": [
      {
        "текст": "(\\d{1,2})\\s*сезон",
        "не якщо": "\\d{1,2}\\s*[-–]\\s*\\d{1,2}\\s*сезон",
        "число": true
      },
      {
        "адреса": "sezon-(\\d{1,2})",
        "число": true
      }
    ]
  },
  "пошук": {
    "адреса": "https://{host}/index.php?do=search&subaction=search&titleonly=3&full_search=1&result_from=1&story={q}",
    "як": "html",
    "картка": "#dle-content .uas-card, .uas-grid .uas-card, #dle-content .short-item",
    "поля": {
      "адреса": {
        "вузол": ".",
        "атрибут": "href",
        "не якщо": "/news/"
      },
      "назва": {
        "вузол": ".uas-card__title",
        "чистка": "назва"
      },
      "оригінал": {
        "вузол": ".uas-card__orig"
      },
      "постер": {
        "вузол": ".uas-card__poster img, img",
        "атрибут": [
          "data-src",
          "src"
        ]
      },
      "рік": {
        "вузол": ".uas-card__year",
        "витяг": "((?:19|20)\\d{2})",
        "число": true
      }
    }
  }
}
